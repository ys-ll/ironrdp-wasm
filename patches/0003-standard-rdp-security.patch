+/// Sends a Share Control PDU, sealing it with the Standard RDP Security
+/// envelope when a security context is active.
+fn encode_share_control_secured(
+    initiator_id: u16,
+    channel_id: u16,
+    share_id: u32,
+    pdu: rdp::headers::ShareControlPdu,
+    security: &SharedRdpSecurity,
+    output: &mut ironrdp_core::WriteBuf,
+) -> ConnectorResult<usize> {
+    match security {
+        Some(ctx) => {
+            let written = rdp::headers::encode_share_control_secured(
+                initiator_id,
+                channel_id,
+                share_id,
+                pdu,
+                &mut ctx.lock().expect("security context mutex poisoned"),
+                output,
+            )
+            .map_err(ConnectorError::encode)?;
+            Ok(written)
+        }
+        None => {
+            let written = rdp::headers::encode_share_control(initiator_id, channel_id, share_id, pdu, output)
+                .map_err(ConnectorError::encode)?;
+            Ok(written)
+        }
+    }
+}
