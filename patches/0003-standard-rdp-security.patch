+/// Encodes a [`ShareControlPdu`] wrapped in an MCS Send Data Request, sealed
+/// with the Standard RDP Security envelope (see [`encode_share_data_secured`]).
+pub fn encode_share_control_secured(
+    initiator_id: u16,
+    channel_id: u16,
+    share_id: u32,
+    pdu: ShareControlPdu,
+    security: &mut crate::crypto::rdp_security::RdpSecurity,
+    buf: &mut WriteBuf,
+) -> EncodeResult<usize> {
+    use std::borrow::Cow;
+
+    let share_control_header = ShareControlHeader {
+        share_control_pdu: pdu,
+        pdu_source: initiator_id,
+        share_id,
+    };
+
+    let user_data = ironrdp_core::encode_vec(&share_control_header)?;
+    let payload = security
+        .encrypt_outbound(&user_data, BasicSecurityHeaderFlags::empty())
+        .map_err(|err| other_err!("encode secured share control", source: err))?;
+
+    let request = crate::mcs::SendDataRequest {
+        initiator_id,
+        channel_id,
+        user_data: Cow::Owned(payload),
+    };
+
+    encode_buf(&crate::x224::X224(request), buf)
+}
