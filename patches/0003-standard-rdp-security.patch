@@ -0,0 +1,526 @@
+//! Standard RDP Security (PROTOCOL_RDP) key derivation and packet protection.
+//!
+//! Implements [MS-RDPBCGR] 5.3 (the pre-TLS RC4-based encryption suite) on top of
+//! the RC4/RSA primitives from [`crate::crypto`]. Every constant and hash schedule
+//! mirrors FreeRDP's `libfreerdp/core/security.c`, which matches the
+//! specification's pseudocode.
+//!
+//! [MS-RDPBCGR]: https://learn.microsoft.com/en-us/openspecs/windows_protocols/ms-rdpbcgr/
+
+use crate::crypto::rc4::Rc4;
+use crate::crypto::rsa::encrypt_with_public_key;
+use crate::gcc::{EncryptionLevel, EncryptionMethod, ServerSecurityData};
+use crate::rdp::headers::{BasicSecurityHeader, BasicSecurityHeaderFlags};
+use crate::{PduError, PduResult};
+
+const CLIENT_RANDOM_LEN: usize = 32;
+
+/// Master secret / session key blob length.
+const SECRET_LEN: usize = 48;
+const SALT_VALUE: [u8; 3] = [0xD1, 0x26, 0x9E];
+const PAD1: [u8; 40] = [0x36; 40];
+const PAD2: [u8; 48] = [0x5C; 48];
+
+/// MAC data sent on the wire is the first 8 bytes of the derived MD5 digest.
+pub const MAC_SIZE: usize = 8;
+
+/// RC4 keys are rolled over after this many encryption/decryption applications
+/// ([MS-RDPBCGR] 5.3.6; FreeRDP `security_encrypt`/`security_decrypt`).
+const KEY_UPDATE_INTERVAL: u32 = 4096;
+
+/// The Standard RDP Security packet-protection state, shared between the
+/// connector, the connection activation sequence and the session: a single
+/// instance owns the RC4 streams for the whole connection.
+pub type SharedRdpSecurity = Option<std::sync::Arc<std::sync::Mutex<RdpSecurity>>>;
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum RdpSecurityMethod {
+    Bit40,
+    Bit56,
+    Bit128,
+}
+
+impl RdpSecurityMethod {
+    /// Effective RC4 key length: 40- and 56-bit keys are salted into an
+    /// 8-byte RC4 key ([MS-RDPBCGR] 5.3.4).
+    fn rc4_key_len(self) -> usize {
+        match self {
+            Self::Bit40 | Self::Bit56 => 8,
+            Self::Bit128 => 16,
+        }
+    }
+
+    fn salt_len(self) -> usize {
+        match self {
+            Self::Bit40 => 3,
+            Self::Bit56 => 1,
+            Self::Bit128 => 0,
+        }
+    }
+
+    /// The client's advertised method set: everything this implementation can do.
+    pub const fn advertised_methods() -> EncryptionMethod {
+        EncryptionMethod::BIT_40
+            .union(EncryptionMethod::BIT_56)
+            .union(EncryptionMethod::BIT_128)
+    }
+
+    /// Maps the server's selected encryption method, rejecting everything this
+    /// implementation cannot satisfy (FIPS uses 3DES/DESX and is not supported).
+    pub fn from_encryption_method(method: EncryptionMethod) -> Result<Option<Self>, PduError> {
+        // The server selects a single bit from the client's advertisement, but the
+        // spec leaves room for multi-bit sets; take the strongest match first.
+        if method.contains(EncryptionMethod::BIT_128) {
+            Ok(Some(Self::Bit128))
+        } else if method.contains(EncryptionMethod::BIT_56) {
+            Ok(Some(Self::Bit56))
+        } else if method.contains(EncryptionMethod::BIT_40) {
+            Ok(Some(Self::Bit40))
+        } else if method.contains(EncryptionMethod::FIPS) {
+            Err(crate::pdu_other_err!("rdp-security", "server selected FIPS encryption, which is not supported"))
+        } else {
+            Ok(None)
+        }
+    }
+}
+
+fn md5(parts: &[&[u8]]) -> [u8; 16] {
+    use md5::{Digest as _, Md5};
+
+    let mut hasher = Md5::new();
+    for part in parts {
+        hasher.update(part);
+    }
+    hasher.finalize().into()
+}
+
+fn sha1(parts: &[&[u8]]) -> [u8; 20] {
+    use sha1::{Digest as _, Sha1};
+
+    let mut hasher = Sha1::new();
+    for part in parts {
+        hasher.update(part);
+    }
+    hasher.finalize().into()
+}
+
+/// `SaltedHash(Salt, Input, Salt1, Salt2) = MD5(Salt + SHA1(Input + Salt + Salt1 + Salt2))`
+fn salted_hash(salt: &[u8; 48], input: &[u8], salt1: &[u8; 32], salt2: &[u8; 32]) -> [u8; 16] {
+    let sha1_digest = sha1(&[input, salt, salt1, salt2]);
+    md5(&[salt, &sha1_digest])
+}
+
+fn premaster_hash(input: &[u8], pre_master: &[u8; 48], client_random: &[u8; 32], server_random: &[u8; 32]) -> [u8; 16] {
+    salted_hash(pre_master, input, client_random, server_random)
+}
+
+fn master_hash(input: &[u8], master_secret: &[u8; 48], client_random: &[u8; 32], server_random: &[u8; 32]) -> [u8; 16] {
+    salted_hash(master_secret, input, server_random, client_random)
+}
+
+/// `MD5_16_32_32(in0, in1, in2) = MD5(in0[16] + in1[32] + in2[32])`
+fn md5_16_32_32(in0: &[u8], in1: &[u8; 32], in2: &[u8; 32]) -> [u8; 16] {
+    md5(&[&in0[..16], in1, in2])
+}
+
+/// `MACData = MD5(MacSaltKey + pad2 + SHA1(MacSaltKey + pad1 + len_le + data))`, first 8 bytes.
+fn mac_digest(mac_salt_key: &[u8; 16], data: &[u8]) -> [u8; 8] {
+    let length = (data.len() as u32).to_le_bytes();
+    let sha1_digest = sha1(&[mac_salt_key, &PAD1, &length, data]);
+    let digest = md5(&[mac_salt_key, &PAD2, &sha1_digest]);
+    digest[..8].try_into().expect("8 bytes")
+}
+
+/// Derived session keys for one direction pair.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub struct DerivedKeys {
+    /// MAC checksum key (`MacSaltKey`), 16 bytes.
+    pub mac_salt_key: [u8; 16],
+    /// Client-to-server RC4 key (salted; only [`Self::rc4_key_len`] bytes are meaningful).
+    pub client_encrypt_key: [u8; 16],
+    /// Server-to-client RC4 key.
+    pub client_decrypt_key: [u8; 16],
+    /// RC4 effective key length.
+    pub rc4_key_len: usize,
+}
+
+/// Derives the standard RDP security session keys from both randoms
+/// ([MS-RDPBCGR] 5.3.4).
+pub fn derive_keys(
+    method: RdpSecurityMethod,
+    client_random: &[u8; 32],
+    server_random: &[u8; 32],
+) -> DerivedKeys {
+    // PreMasterSecret = first 24 bytes of each random (FreeRDP
+    // `security_establish_keys`; MS-RDPBCGR 5.3.4 says "most significant 24 bytes").
+    let mut pre_master = [0u8; SECRET_LEN];
+    pre_master[..24].copy_from_slice(&client_random[..24]);
+    pre_master[24..].copy_from_slice(&server_random[..24]);
+
+    // MasterSecret = PremasterHash('A') + PremasterHash('BB') + PremasterHash('CCC')
+    let mut master_secret = [0u8; SECRET_LEN];
+    master_secret[..16].copy_from_slice(&premaster_hash(b"A", &pre_master, client_random, server_random));
+    master_secret[16..32].copy_from_slice(&premaster_hash(b"BB", &pre_master, client_random, server_random));
+    master_secret[32..].copy_from_slice(&premaster_hash(b"CCC", &pre_master, client_random, server_random));
+
+    // SessionKeyBlob = MasterHash('A') + MasterHash('BB') + MasterHash('CCC')
+    let mut session_key_blob = [0u8; SECRET_LEN];
+    session_key_blob[..16].copy_from_slice(&master_hash(b"A", &master_secret, client_random, server_random));
+    session_key_blob[16..32].copy_from_slice(&master_hash(b"BB", &master_secret, client_random, server_random));
+    session_key_blob[32..].copy_from_slice(&master_hash(b"CCC", &master_secret, client_random, server_random));
+
+    let mac_salt_key = session_key_blob[..16].try_into().expect("16 bytes");
+
+    // Client view: the server-to-client key comes first in the blob.
+    let mut client_decrypt_key = md5_16_32_32(&session_key_blob[16..], client_random, server_random);
+    let mut client_encrypt_key = md5_16_32_32(&session_key_blob[32..], client_random, server_random);
+
+    let salt_len = method.salt_len();
+    if salt_len > 0 {
+        client_decrypt_key[..salt_len].copy_from_slice(&SALT_VALUE[..salt_len]);
+        client_encrypt_key[..salt_len].copy_from_slice(&SALT_VALUE[..salt_len]);
+    }
+
+    DerivedKeys {
+        mac_salt_key,
+        client_encrypt_key,
+        client_decrypt_key,
+        rc4_key_len: method.rc4_key_len(),
+    }
+}
+
+/// One direction's RC4 stream plus its rollover bookkeeping
+/// (FreeRDP `security_encrypt` / `security_decrypt` / `security_key_update`).
+#[derive(Debug, Clone)]
+struct DirectionalStream {
+    key: [u8; 16],
+    update_key: [u8; 16],
+    key_len: usize,
+    salt_len: usize,
+    cipher: Rc4,
+    use_count: u32,
+}
+
+impl DirectionalStream {
+    fn new(key: &[u8; 16], key_len: usize, salt_len: usize) -> Self {
+        Self {
+            key: *key,
+            update_key: *key,
+            key_len,
+            salt_len,
+            cipher: Rc4::new(&key[..key_len]),
+            use_count: 0,
+        }
+    }
+
+    fn apply(&mut self, data: &mut [u8]) {
+        if self.use_count >= KEY_UPDATE_INTERVAL {
+            self.roll();
+        }
+        let encrypted = self.cipher.process(data);
+        data.copy_from_slice(&encrypted);
+        self.use_count += 1;
+    }
+
+    fn roll(&mut self) {
+        let sha1_digest = sha1(&[&self.update_key[..self.key_len], &PAD1, &self.key[..self.key_len]]);
+        let mut new_key = md5(&[&self.update_key[..self.key_len], &PAD2, &sha1_digest]);
+        let mut cipher = Rc4::new(&new_key[..self.key_len]);
+        let encrypted = cipher.process(&new_key[..self.key_len]);
+        new_key[..self.key_len].copy_from_slice(&encrypted);
+        if self.salt_len > 0 {
+            new_key[..self.salt_len].copy_from_slice(&SALT_VALUE[..self.salt_len]);
+        }
+        self.key = new_key;
+        self.cipher = Rc4::new(&self.key[..self.key_len]);
+        self.use_count = 0;
+    }
+}
+
+/// Full standard RDP security state for one session: the RC4 streams for both
+/// directions and the MAC key.
+///
+/// The RC4 stream state is continuous across every encrypted packet of the
+/// session (slow path, fast path, connector phases), so a single instance must
+/// be shared by everything that (de)serializes packets.
+#[derive(Debug, Clone)]
+pub struct RdpSecurity {
+    method: RdpSecurityMethod,
+    level: EncryptionLevel,
+    client_encrypt: DirectionalStream,
+    client_decrypt: DirectionalStream,
+    mac_salt_key: [u8; 16],
+}
+
+impl RdpSecurity {
+    /// Builds the state from both randoms. Called by the client after the
+    /// server's GCC `ServerSecurityData` has been received; the same client
+    /// random must then be sent in the Security Exchange PDU.
+    pub fn new(client_random: &[u8; CLIENT_RANDOM_LEN], server_data: &ServerSecurityData) -> PduResult<Self> {
+        let Some(server_random) = server_data.server_random else {
+            return Err(crate::pdu_other_err!("rdp-security", "server security data has no server random"));
+        };
+
+        let method = RdpSecurityMethod::from_encryption_method(server_data.encryption_method)?
+            .ok_or_else(|| crate::pdu_other_err!("rdp-security", "server selected no encryption method"))?;
+
+        if server_data.encryption_level == EncryptionLevel::None {
+            return Err(crate::pdu_other_err!(
+                "rdp-security",
+                "server selected an encryption method with ENCRYPTION_LEVEL_NONE"
+            ));
+        }
+
+        let keys = derive_keys(method, client_random, &server_random);
+        Ok(Self {
+            method,
+            level: server_data.encryption_level,
+            client_encrypt: DirectionalStream::new(&keys.client_encrypt_key, keys.rc4_key_len, method.salt_len()),
+            client_decrypt: DirectionalStream::new(&keys.client_decrypt_key, keys.rc4_key_len, method.salt_len()),
+            mac_salt_key: keys.mac_salt_key,
+        })
+    }
+
+    pub fn method(&self) -> RdpSecurityMethod {
+        self.method
+    }
+
+    pub fn encryption_level(&self) -> EncryptionLevel {
+        self.level
+    }
+
+    /// MAC checksum for outgoing data (client-to-server key), computed over the
+    /// plaintext.
+    pub fn client_mac(&self, data: &[u8]) -> [u8; MAC_SIZE] {
+        mac_digest(&self.mac_salt_key, data)
+    }
+
+    /// MAC checksum for verifying incoming data (server-to-client key), computed
+    /// over the plaintext.
+    pub fn server_mac(&self, data: &[u8]) -> [u8; MAC_SIZE] {
+        mac_digest(&self.mac_salt_key, data)
+    }
+
+    /// Encrypts a client-to-server payload in place, advancing the RC4 stream.
+    pub fn encrypt(&mut self, data: &mut [u8]) {
+        self.client_encrypt.apply(data);
+    }
+
+    /// Decrypts a server-to-client payload in place, advancing the RC4 stream.
+    pub fn decrypt(&mut self, data: &mut [u8]) {
+        self.client_decrypt.apply(data);
+    }
+
+    /// Wraps a client-to-server payload in the standard RDP security envelope:
+    /// `BasicSecurityHeader(ENCRYPT | extra_flags)` + 8-byte MAC + ciphertext.
+    pub fn encrypt_outbound(&mut self, payload: &[u8], extra_flags: BasicSecurityHeaderFlags) -> PduResult<Vec<u8>> {
+        use ironrdp_core::encode_vec;
+
+        let mac = self.client_mac(payload);
+        let mut ciphertext = payload.to_vec();
+        self.encrypt(&mut ciphertext);
+
+        let header = BasicSecurityHeader {
+            flags: BasicSecurityHeaderFlags::ENCRYPT | extra_flags,
+        };
+
+        let mut out = Vec::with_capacity(BasicSecurityHeader::FIXED_PART_SIZE + MAC_SIZE + ciphertext.len());
+        out.extend_from_slice(&encode_vec(&header).map_err(|err| crate::pdu_other_err!("encode security header", source: err))?);
+        out.extend_from_slice(&mac);
+        out.extend_from_slice(&ciphertext);
+        Ok(out)
+    }
+
+    /// Unwraps a server-to-client payload in place. The payload must start with
+    /// a `BasicSecurityHeader`; when it carries the `ENCRYPT` flag the body
+    /// (after the 8-byte MAC) is MAC-verified and decrypted in place.
+    ///
+    /// Returns the header flags and the offset of the (now plaintext) body
+    /// within `payload` — `BasicSecurityHeader::FIXED_PART_SIZE` when the
+    /// `ENCRYPT` flag was absent, `FIXED_PART_SIZE + MAC_SIZE` otherwise. The
+    /// header bytes themselves are left untouched, so decoders that expect to
+    /// consume their own security header (licensing, multitransport) keep
+    /// working unchanged.
+    pub fn decrypt_inbound(&mut self, payload: &mut [u8]) -> PduResult<(BasicSecurityHeaderFlags, usize)> {
+        use ironrdp_core::Decode as _;
+
+        let mut cursor = ironrdp_core::ReadCursor::new(payload);
+        let header = BasicSecurityHeader::decode(&mut cursor)
+            .map_err(|err| crate::pdu_other_err!("decode security header", source: err))?;
+        let body_offset = BasicSecurityHeader::FIXED_PART_SIZE;
+
+        if !header.flags.contains(BasicSecurityHeaderFlags::ENCRYPT) {
+            return Ok((header.flags, body_offset));
+        }
+
+        let rest = &mut payload[body_offset..];
+        if rest.len() < MAC_SIZE {
+            return Err(crate::pdu_other_err!("rdp-security", "encrypted payload is shorter than the MAC size"));
+        }
+        let (mac, ciphertext) = rest.split_at_mut(MAC_SIZE);
+        // The MAC covers the plaintext; decrypt first, then verify.
+        self.client_decrypt.apply(ciphertext);
+        let expected = mac_digest(&self.mac_salt_key, ciphertext);
+        if mac != expected.as_slice() {
+            return Err(crate::pdu_other_err!("rdp-security", "packet MAC verification failed"));
+        }
+
+        Ok((header.flags, body_offset + MAC_SIZE))
+    }
+}
+
+/// Encrypts the 32-byte client random with the server's RSA public key for the
+/// Security Exchange PDU, returning the ciphertext sized to the modulus
+/// ([MS-RDPBCGR] 2.2.1.4.1).
+///
+/// The public key must be a PKCS#1 DER `RsaPublicKey` (as produced by
+/// [`crate::rdp::server_license::ServerCertificate::get_public_key`]).
+pub fn encrypt_client_random(client_random: &[u8; CLIENT_RANDOM_LEN], public_key_der: &[u8]) -> PduResult<Vec<u8>> {
+    let modulus_len = rsa_modulus_len(public_key_der)?;
+    let mut encrypted = encrypt_with_public_key(client_random, public_key_der)
+        .map_err(|err| crate::pdu_other_err!("encrypt client random", source: err))?;
+
+    // Normalize to exactly one modulus worth of bytes: `encrypt_with_public_key`
+    // returns the minimal big-endian-trimmed little-endian integer plus padding.
+    if encrypted.len() > modulus_len {
+        encrypted.truncate(modulus_len);
+    } else {
+        encrypted.resize(modulus_len, 0);
+    }
+    Ok(encrypted)
+}
+
+fn rsa_modulus_len(public_key_der: &[u8]) -> PduResult<usize> {
+    use der_parser::parse_der;
+
+    let (_, der_object) = parse_der(public_key_der)
+        .map_err(|err| crate::pdu_other_err!("parse server public key", source: err))?;
+    let sequence = der_object
+        .as_sequence()
+        .map_err(|err| crate::pdu_other_err!("parse server public key", source: err))?;
+    let modulus = sequence
+        .first()
+        .ok_or_else(|| crate::pdu_other_err!("rdp-security", "server public key has no modulus"))?
+        .as_slice()
+        .map_err(|err| crate::pdu_other_err!("parse server public key", source: err))?;
+    Ok(modulus.len())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn derive_keys_is_deterministic_and_directional() {
+        let client_random = [0x44u8; 32];
+        let server_random = [0x55u8; 32];
+
+        let keys = derive_keys(RdpSecurityMethod::Bit128, &client_random, &server_random);
+        let again = derive_keys(RdpSecurityMethod::Bit128, &client_random, &server_random);
+        assert_eq!(keys, again);
+        assert_ne!(keys.client_encrypt_key, keys.client_decrypt_key);
+        assert_eq!(keys.rc4_key_len, 16);
+    }
+
+    #[test]
+    fn short_keys_are_salted() {
+        let client_random = [0x44u8; 32];
+        let server_random = [0x55u8; 32];
+
+        let keys40 = derive_keys(RdpSecurityMethod::Bit40, &client_random, &server_random);
+        assert_eq!(&keys40.client_encrypt_key[..3], &SALT_VALUE);
+        assert_eq!(&keys40.client_decrypt_key[..3], &SALT_VALUE);
+        assert_eq!(keys40.rc4_key_len, 8);
+
+        let keys56 = derive_keys(RdpSecurityMethod::Bit56, &client_random, &server_random);
+        assert_eq!(keys56.client_encrypt_key[0], SALT_VALUE[0]);
+        assert_eq!(keys56.rc4_key_len, 8);
+    }
+
+    #[test]
+    fn mac_is_deterministic_and_length_sensitive() {
+        let keys = derive_keys(RdpSecurityMethod::Bit128, &[0x44u8; 32], &[0x55u8; 32]);
+        let mac1 = mac_digest(&keys.mac_salt_key, b"hello");
+        let mac2 = mac_digest(&keys.mac_salt_key, b"hello");
+        let mac3 = mac_digest(&keys.mac_salt_key, b"hello!");
+        assert_eq!(mac1, mac2);
+        assert_ne!(mac1, mac3);
+    }
+
+    #[test]
+    fn security_stream_round_trips_and_advances() {
+        let client_random = [0x01u8; 32];
+        let server_random = [0x02u8; 32];
+        let server_data = ServerSecurityData {
+            encryption_method: EncryptionMethod::BIT_128,
+            encryption_level: EncryptionLevel::ClientCompatible,
+            server_random: Some(server_random),
+            server_cert: Vec::new(),
+        };
+
+        let mut security = RdpSecurity::new(&client_random, &server_data).expect("build security state");
+
+        // Round trip.
+        let mut packet = [0x41u8; 64];
+        let mac = security.client_mac(&packet);
+        security.encrypt(&mut packet);
+        assert_ne!(packet, [0x41u8; 64]);
+        security.decrypt(&mut packet);
+        assert_eq!(packet, [0x41u8; 64]);
+
+        // The MAC covers the plaintext, not the ciphertext.
+        let mac_over_ciphertext = security.client_mac(&{
+            let mut encrypted = [0x41u8; 64];
+            security.encrypt(&mut encrypted);
+            encrypted
+        });
+        assert_ne!(mac, mac_over_ciphertext);
+
+        // The RC4 stream advances across packets in both directions.
+        let mut first = [0x42u8; 32];
+        let mut second = [0x42u8; 32];
+        let mac1 = security.client_mac(&first);
+        let mac2 = security.client_mac(&second);
+        security.encrypt(&mut first);
+        security.encrypt(&mut second);
+        assert_ne!(first, second);
+        assert_ne!(mac1, mac2);
+        security.decrypt(&mut second);
+        assert_eq!(second, [0x42u8; 32]);
+    }
+
+    #[test]
+    fn key_rollover_keeps_stream_symmetric() {
+        let client_random = [0x03u8; 32];
+        let server_random = [0x04u8; 32];
+        let server_data = ServerSecurityData {
+            encryption_method: EncryptionMethod::BIT_128,
+            encryption_level: EncryptionLevel::High,
+            server_random: Some(server_random),
+            server_cert: Vec::new(),
+        };
+        let mut security = RdpSecurity::new(&client_random, &server_data).expect("build security state");
+
+        // Drive both directions past the rollover threshold and back.
+        for i in 0..KEY_UPDATE_INTERVAL + 5u32 {
+            let mut plaintext = [0x77u8; 16];
+            plaintext[0] = i as u8;
+            let mac = security.client_mac(&plaintext);
+            security.encrypt(&mut plaintext);
+            security.decrypt(&mut plaintext);
+            assert_eq!(plaintext[0], i as u8);
+            assert_eq!(mac, security.server_mac(&plaintext));
+        }
+    }
+
+    #[test]
+    fn fips_is_rejected() {
+        let server_data = ServerSecurityData {
+            encryption_method: EncryptionMethod::FIPS,
+            encryption_level: EncryptionLevel::Fips,
+            server_random: Some([0u8; 32]),
+            server_cert: Vec::new(),
+        };
+        assert!(RdpSecurity::new(&[0u8; 32], &server_data).is_err());
+    }
+}
