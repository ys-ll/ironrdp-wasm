+impl FastPathInput {
+    /// Encodes the input PDU sealed with the Standard RDP Security envelope:
+    /// the header carries the `ENCRYPTED` flag and is followed by the 8-byte
+    /// MAC (computed over the plaintext events) and the RC4 ciphertext
+    /// ([MS-RDPBCGR] 2.2.8.1.2).
+    pub fn encode_secured(&self, security: &mut crate::crypto::rdp_security::RdpSecurity) -> EncodeResult<Vec<u8>> {
+        if self.0.is_empty() {
+            return Err(other_err!("Empty fast-path input"));
+        }
+
+        let data_length = self.0.iter().map(Encode::size).sum::<usize>();
+        let mut plaintext = vec![0u8; data_length];
+        {
+            let mut cursor = WriteCursor::new(&mut plaintext);
+            for event in self.0.iter() {
+                event.encode(&mut cursor)?;
+            }
+        }
+
+        let mac = security.client_mac(&plaintext);
+        let mut ciphertext = plaintext;
+        security.encrypt(&mut ciphertext);
+
+        let header = FastPathInputHeader {
+            num_events: u8::try_from(self.0.len())
+                .expect("per invariant (1..=FastPathInput::MAX_EVENTS).contains(num_events.len())"),
+            flags: EncryptionFlags::ENCRYPTED,
+            data_length: crate::crypto::rdp_security::MAC_SIZE + ciphertext.len(),
+        };
+
+        let mut out = vec![0u8; header.size()];
+        header.encode(&mut WriteCursor::new(&mut out))?;
+        out.extend_from_slice(&mac);
+        out.extend_from_slice(&ciphertext);
+        Ok(out)
+    }
+}
