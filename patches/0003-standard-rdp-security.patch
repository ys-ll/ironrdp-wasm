+/// Decodes the Send Data Indication of an inbound PDU, decrypting the Standard
+/// RDP Security envelope first when a security context is active.
+///
+/// When `strip` is set the outer `BasicSecurityHeader` (and the MAC, when the
+/// `ENCRYPT` flag was present) is removed so the payload starts directly with
+/// the Share Control header. Decoders that consume their own security header
+/// (licensing, multitransport) pass `false`.
+pub(crate) fn decode_ctx_with_security<'a>(
+    input: &'a [u8],
+    security: &SharedRdpSecurity,
+    strip: bool,
+) -> ConnectorResult<mcs::SendDataIndicationCtx<'a>> {
+    let ctx = ironrdp_pdu::mcs::decode_send_data_indication(input).map_err(ConnectorError::decode)?;
+    match security {
+        None => Ok(ctx),
+        Some(ctx_security) => {
+            let mut user_data = ctx.user_data.into_owned();
+            let (flags, body_offset) = ctx_security
+                .lock()
+                .expect("security context mutex poisoned")
+                .decrypt_inbound(&mut user_data)
+                .map_err(ConnectorError::decode)?;
+
+            if strip && !flags.contains(ironrdp_pdu::rdp::headers::BasicSecurityHeaderFlags::REDIRECTION_PKT) {
+                Ok(mcs::SendDataIndicationCtx {
+                    initiator_id: ctx.initiator_id,
+                    channel_id: ctx.channel_id,
+                    user_data: Cow::Owned(user_data[body_offset..].to_vec()),
+                })
+            } else {
+                // Keep the header in place: decoders like the Standard Security
+                // Server Redirection PDU parse it themselves.
+                Ok(mcs::SendDataIndicationCtx {
+                    initiator_id: ctx.initiator_id,
+                    channel_id: ctx.channel_id,
+                    user_data: Cow::Owned(user_data),
+                })
+            }
+        }
+    }
+}
