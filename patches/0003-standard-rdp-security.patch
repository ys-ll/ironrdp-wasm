diff --git a/crates/ironrdp-pdu/src/rdp/security_exchange.rs b/crates/ironrdp-pdu/src/rdp/security_exchange.rs
new file mode 100644
index 00000000..76fb900a
--- /dev/null
+++ b/crates/ironrdp-pdu/src/rdp/security_exchange.rs
@@ -0,0 +1,71 @@
+use ironrdp_core::{
+    Decode, DecodeResult, Encode, EncodeResult, ReadCursor, WriteCursor, cast_length, ensure_fixed_part_size,
+    ensure_size, invalid_field_err,
+};
+
+use crate::rdp::headers::{BASIC_SECURITY_HEADER_SIZE, BasicSecurityHeader, BasicSecurityHeaderFlags};
+
+/// Maximum length of the RSA-encrypted client random (2048-bit modulus).
+const MAX_ENCRYPTED_RANDOM_LEN: usize = 256;
+
+/// Security Exchange PDU ([MS-RDPBCGR 2.2.1.4.1]), sent by the client during the
+/// RDP Security Commencement phase of a Standard RDP Security session.
+///
+/// The PDU consists of a Basic Security Header with the `EXCHANGE_PKT` flag,
+/// followed by the RSA-encrypted client random.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct SecurityExchangePdu {
+    pub encrypted_client_random: Vec<u8>,
+}
+
+impl SecurityExchangePdu {
+    const NAME: &'static str = "SecurityExchangePdu";
+
+    const FIXED_PART_SIZE: usize = BASIC_SECURITY_HEADER_SIZE + 4;
+}
+
+impl Encode for SecurityExchangePdu {
+    fn encode(&self, dst: &mut WriteCursor<'_>) -> EncodeResult<()> {
+        ensure_size!(in: dst, size: self.size());
+
+        BasicSecurityHeader {
+            flags: BasicSecurityHeaderFlags::EXCHANGE_PKT,
+        }
+        .encode(dst)?;
+
+        dst.write_u32(cast_length!("encryptedClientRandomLen", self.encrypted_client_random.len(), in: dst)?);
+        dst.write_slice(&self.encrypted_client_random);
+
+        Ok(())
+    }
+
+    fn name(&self) -> &'static str {
+        Self::NAME
+    }
+
+    fn size(&self) -> usize {
+        BasicSecurityHeader::FIXED_PART_SIZE + 4 + self.encrypted_client_random.len()
+    }
+}
+
+impl<'de> Decode<'de> for SecurityExchangePdu {
+    fn decode(src: &mut ReadCursor<'de>) -> DecodeResult<Self> {
+        let header = BasicSecurityHeader::decode(src)?;
+        if !header.flags.contains(BasicSecurityHeaderFlags::EXCHANGE_PKT) {
+            return Err(invalid_field_err!("flags", "not a Security Exchange PDU", in: src));
+        }
+
+        ensure_fixed_part_size!(in: src);
+        let length = cast_length!("encryptedClientRandomLen", src.read_u32(), in: src)?;
+        if length > MAX_ENCRYPTED_RANDOM_LEN {
+            return Err(invalid_field_err!("encryptedClientRandomLen", "invalid encrypted client random length", in: src));
+        }
+
+        ensure_size!(in: src, size: length);
+        let encrypted_client_random = src.read_slice(length).to_vec();
+
+        Ok(Self {
+            encrypted_client_random,
+        })
+    }
+}
