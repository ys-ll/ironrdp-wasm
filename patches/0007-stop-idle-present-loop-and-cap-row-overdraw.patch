+/// Tall regions that cover most of the width win from row-wise copies; narrow
+/// tall strips do not, and would otherwise copy the whole image width per row.
+fn widens_within_overdraw_cap(image: &DecodedImage, region: &InclusiveRectangle) -> bool {
+    let widened = u64::from(image.width()) * u64::from(region.height()) * OVERDRAW_DENOMINATOR;
+    let cap = u64::from(region.width()) * u64::from(region.height()) * OVERDRAW_NUMERATOR;
+
+    widened <= cap
+}
