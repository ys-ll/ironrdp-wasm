index 0000000..6aef0b8
--- /dev/null
+++ b/crates/ironrdp-web/src/present_loop.rs
@@ -0,0 +1,123 @@
+//! Lifecycle state for the requestAnimationFrame present loop.
+//!
+//! Kept free of DOM types so the state machine can be unit tested on the host
+//! target, where the rest of this crate cannot compile (web-sys types are
+//! wasm-only at the call sites).
+
+use core::cell::RefCell;
+use std::rc::Rc;
+
+/// What the present loop should do on its next tick.
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub(crate) enum FrameAction {
+    /// A region was uploaded since the previous tick: present it.
+    Present,
+    /// Nothing was uploaded: skip the draw call.
+    Skip,
+    /// The owning `Canvas` is gone: stop rescheduling the loop.
+    Stop,
+}
+
+/// State shared between `Canvas` and its present-loop closure.
+///
+/// `dirty` is set by the upload path and consumed by exactly one present tick.
+/// `stopped` is set when the `PresentLoop` handle owned by `Canvas` is dropped;
+/// the loop observes it on its next tick and unregisters itself.
+#[derive(Debug)]
+pub(crate) struct PresentLoopState {
+    dirty: bool,
+    stopped: bool,
+}
+
+impl PresentLoopState {
+    fn new() -> Self {
+        Self {
+            dirty: false,
+            stopped: false,
+        }
+    }
+
+    pub(crate) fn mark_dirty(&mut self) {
+        if !self.stopped {
+            self.dirty = true;
+        }
+    }
+
+    pub(crate) fn stop(&mut self) {
+        self.stopped = true;
+        self.dirty = false;
+    }
+
+    pub(crate) fn next_frame(&mut self) -> FrameAction {
+        if self.stopped {
+            FrameAction::Stop
+        } else if self.dirty {
+            self.dirty = false;
+            FrameAction::Present
+        } else {
+            FrameAction::Skip
+        }
+    }
+}
+
+/// Handle owned by `Canvas`. Dropping it stops the present loop.
+pub(crate) struct PresentLoop {
+    state: Rc<RefCell<PresentLoopState>>,
+}
+
+impl PresentLoop {
+    pub(crate) fn new() -> Self {
+        Self {
+            state: Rc::new(RefCell::new(PresentLoopState::new())),
+        }
+    }
+
+    pub(crate) fn mark_dirty(&self) {
+        self.state.borrow_mut().mark_dirty();
+    }
+
+    pub(crate) fn shared_state(&self) -> Rc<RefCell<PresentLoopState>> {
+        Rc::clone(&self.state)
+    }
+}
+
+impl Drop for PresentLoop {
+    fn drop(&mut self) {
+        self.state.borrow_mut().stop();
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::{FrameAction, PresentLoop, PresentLoopState};
+
+    #[test]
+    fn present_loop_skips_clean_frames() {
+        let mut state = PresentLoopState::new();
+        assert_eq!(state.next_frame(), FrameAction::Skip);
+        assert_eq!(state.next_frame(), FrameAction::Skip);
+    }
+
+    #[test]
+    fn present_loop_presents_once_per_upload() {
+        let mut state = PresentLoopState::new();
+        state.mark_dirty();
+        assert_eq!(state.next_frame(), FrameAction::Present);
+        assert_eq!(state.next_frame(), FrameAction::Skip);
+    }
+
+    #[test]
+    fn present_loop_stops_after_the_owner_is_dropped() {
+        let owner = PresentLoop::new();
+        let loop_state = owner.shared_state();
+        owner.mark_dirty();
+        assert_eq!(loop_state.borrow_mut().next_frame(), FrameAction::Present);
+
+        drop(owner);
+
+        assert_eq!(loop_state.borrow_mut().next_frame(), FrameAction::Stop);
+        // A late upload must not resurrect a stopped loop.
+        loop_state.borrow_mut().mark_dirty();
+        assert_eq!(loop_state.borrow_mut().next_frame(), FrameAction::Stop);
+    }
+}
