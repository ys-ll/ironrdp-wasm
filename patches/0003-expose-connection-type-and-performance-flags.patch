+/// Map a raw TS_CONNECTION_TYPE value (MS-RDPBCGR 2.2.1.11.1.1.1.1) to the
+/// GCC enum; unknown values fall back to `None` and keep the default.
+fn connection_type_from_u32(value: u32) -> Option<ironrdp::pdu::gcc::ConnectionType> {
+    match value {
+        0 => Some(ironrdp::pdu::gcc::ConnectionType::NotUsed),
+        1 => Some(ironrdp::pdu::gcc::ConnectionType::Modem),
+        2 => Some(ironrdp::pdu::gcc::ConnectionType::BroadbandLow),
+        3 => Some(ironrdp::pdu::gcc::ConnectionType::Satellite),
+        4 => Some(ironrdp::pdu::gcc::ConnectionType::BroadbandHigh),
+        5 => Some(ironrdp::pdu::gcc::ConnectionType::Wan),
+        6 => Some(ironrdp::pdu::gcc::ConnectionType::Lan),
+        7 => Some(ironrdp::pdu::gcc::ConnectionType::Autodetect),
+        _ => None,
+    }
+}
